DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
PORT=3000
NODE_ENV=development

# Mail Merkezi (SMTP bilgileri tamamlanana kadar gönderim kapalıdır)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# `npm run security:key` ile üretin; paylaşmayın ve kaybetmeyin.
PERSONAL_DATA_ENCRYPTION_KEY=
