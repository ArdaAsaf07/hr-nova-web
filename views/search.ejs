<!DOCTYPE html><html lang="tr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>HR Nova | Arama</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet"><link rel="stylesheet" href="/css/style.css"></head><body><div class="hr-nova-layout"><%- include('partials/sidebar',{activePage:''}) %><main class="main-content"><%- include('partials/topbar',{pageTitle:'Arama'}) %><div class="content-wrapper"><div class="page-header"><div><h2 class="page-title">Personel ve Eğitim Ara</h2><p class="page-description">Ad, departman veya eğitim adına göre arayın.</p></div></div><form class="nova-card p-4 mb-4" method="GET"><div class="d-flex gap-2"><input class="form-control-nova" name="q" value="<%= query %>" minlength="2" placeholder="En az 2 karakter yazın" autofocus><button class="btn-nova btn-primary-nova"><i class="bi bi-search"></i> Ara</button></div></form><% if(query){ %><div class="row g-4"><div class="col-lg-6"><div class="nova-card p-3"><h3 class="nova-card-title">Personeller (<%= employees.length %>)</h3><% employees.forEach(x=>{ %><p><a href="/employees/<%= x.id %>/edit"><%= x.first_name %> <%= x.last_name %></a> — <%= x.department_name||'Departmansız' %></p><% }) %><% if(!employees.length){ %><p>Sonuç bulunamadı.</p><% } %></div></div><div class="col-lg-6"><div class="nova-card p-3"><h3 class="nova-card-title">Eğitimler (<%= trainings.length %>)</h3><% trainings.forEach(x=>{ %><p><%= x.name %> — <%= x.employee_name||'Atanmamış' %></p><% }) %><% if(!trainings.length){ %><p>Sonuç bulunamadı.</p><% } %></div></div></div><% } %></div><%- include('partials/footer') %></main></div><script src="/js/sidebar.js"></script></body></html>
