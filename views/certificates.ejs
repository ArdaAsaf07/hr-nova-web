<!DOCTYPE html><html lang="tr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>HR Nova | Sertifikalar</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="/css/style.css"></head><body><div class="hr-nova-layout"><%- include("partials/sidebar",{activePage:"certificates"}) %><main class="main-content"><%- include("partials/topbar",{pageTitle:"Sertifikalar"}) %><div class="content-wrapper"><div class="page-header"><div><h2 class="page-title">Sertifikalar</h2><p class="page-description">Tamamlanan eğitimlerin sertifika kayıtları.</p></div></div><div class="nova-card"><div class="nova-table-wrapper"><table class="nova-table"><thead><tr><th>Sertifika No</th><th>Personel</th><th>Eğitim</th><th>Tamamlanma</th><th>Süre</th></tr></thead><tbody><% certificates.forEach(x=>{ %><tr><td>HRN-<%= String(x.id).padStart(6,'0') %></td><td><%= x.employee_name %></td><td><%= x.name %></td><td><%= x.end_date?new Date(x.end_date).toLocaleDateString('tr-TR'):'-' %></td><td><%= x.duration||'-' %></td></tr><% }) %><% if(!certificates.length){ %><tr><td colspan="5">Tamamlandı durumunda eğitim bulunmuyor.</td></tr><% } %></tbody></table></div></div></div><%- include("partials/footer") %></main></div></body></html>
