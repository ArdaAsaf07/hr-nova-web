<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HR Nova | Departman Düzenle</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <div class="hr-nova-layout">
        <%- include("partials/sidebar", { activePage: "departments" }) %>

        <main class="main-content">
            <%- include("partials/topbar", { pageTitle: "Departmanlar" }) %>

            <div class="content-wrapper">
                <div class="page-header">
                    <div class="page-header-left">
                        <h2 class="page-title">Departman Düzenle</h2>
                        <p class="page-description">
                            Departman bilgilerini güncelleyin ve değişiklikleri kaydedin.
                        </p>
                    </div>

                    <div class="page-actions">
                        <a href="/departments" class="btn-nova btn-secondary-nova">
                            <i class="bi bi-arrow-left"></i>
                            Departmanlara Dön
                        </a>
                    </div>
                </div>

                <% if (error) { %>
                    <div class="alert-nova alert-danger-nova">
                        <i class="bi bi-exclamation-circle-fill"></i>
                        <div><%= error %></div>
                    </div>
                <% } %>

                <div class="row justify-content-center">
                    <div class="col-xl-8 col-lg-10">
                        <div class="form-card">
                            <div class="form-section">
                                <div class="person-cell mb-4">
                                    <div class="person-avatar">
                                        <i class="bi bi-building"></i>
                                    </div>

                                    <div>
                                        <h3 class="form-section-title mb-1">Departman Bilgileri</h3>
                                        <p class="form-section-description mb-0">
                                            Güncellemek istediğiniz alanları düzenleyin.
                                        </p>
                                    </div>
                                </div>

                                <form action="/departments/<%= department.id %>/update" method="POST">
                                    <div class="mb-3">
                                        <label class="form-label-nova" for="departmentName">
                                            Departman Adı
                                            <span class="form-required">*</span>
                                        </label>
                                        <input
                                            type="text"
                                            id="departmentName"
                                            name="name"
                                            class="form-control-nova"
                                            value="<%= department.name %>"
                                            maxlength="100"
                                            required
                                        >
                                    </div>

                                    <div class="mb-4">
                                        <label class="form-label-nova" for="departmentDescription">Açıklama</label>
                                        <textarea
                                            id="departmentDescription"
                                            name="description"
                                            class="form-control-nova"
                                            rows="5"
                                            placeholder="Departmanın görevini açıklayın..."
                                        ><%= department.description || "" %></textarea>
                                    </div>

                                    <div class="d-flex flex-wrap justify-content-end gap-2">
                                        <a href="/departments" class="btn-nova btn-secondary-nova">İptal</a>
                                        <button type="submit" class="btn-nova btn-primary-nova">
                                            <i class="bi bi-check-circle-fill"></i>
                                            Değişiklikleri Kaydet
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <%- include("partials/footer") %>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/sidebar.js"></script>
</body>

</html>
