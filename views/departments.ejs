<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>HR Nova | Departmanlar</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="/css/style.css"
    >
</head>

<body>

    <div class="hr-nova-layout">

        <%- include("partials/sidebar", {
            activePage: "departments"
        }) %>

        <main class="main-content">

            <%- include("partials/topbar", {
                pageTitle: "Departmanlar"
            }) %>

            <div class="content-wrapper">

                <div class="page-header">

                    <div class="page-header-left">

                        <h2 class="page-title">
                            Departman Yönetimi
                        </h2>

                        <p class="page-description">
                            Şirket departmanlarını ekleyin, düzenleyin ve yönetin.
                        </p>

                    </div>

                    <div class="page-actions">

                        <a
                            href="/"
                            class="btn-nova btn-secondary-nova"
                        >
                            <i class="bi bi-grid-1x2-fill"></i>
                            Ana Sayfa
                        </a>

                    </div>

                </div>

                <% if (success) { %>

                    <div class="alert-nova alert-success-nova">

                        <i class="bi bi-check-circle-fill"></i>

                        <div>
                            <%= success %>
                        </div>

                    </div>

                <% } %>

                <% if (error) { %>

                    <div class="alert-nova alert-danger-nova">

                        <i class="bi bi-exclamation-circle-fill"></i>

                        <div>
                            <%= error %>
                        </div>

                    </div>

                <% } %>

                <div class="row g-4">

                    <div class="col-xl-4">

                        <div class="form-card">

                            <div class="form-section">

                                <h3 class="form-section-title">
                                    Yeni Departman
                                </h3>

                                <p class="form-section-description">
                                    Sisteme yeni bir departman ekleyin.
                                </p>

                                <form action="/departments" method="POST">

                                    <div class="mb-3">

                                        <label class="form-label-nova">
                                            Departman Adı
                                            <span class="form-required">*</span>
                                        </label>

                                        <input
                                            type="text"
                                            name="name"
                                            class="form-control-nova"
                                            maxlength="100"
                                            placeholder="Örneğin: Satış"
                                            required
                                        >

                                    </div>

                                    <div class="mb-4">

                                        <label class="form-label-nova">
                                            Açıklama
                                        </label>

                                        <textarea
                                            name="description"
                                            class="form-control-nova"
                                            placeholder="Departmanın görevini açıklayın..."
                                        ></textarea>

                                    </div>

                                    <button
                                        type="submit"
                                        class="btn-nova btn-primary-nova w-100"
                                    >
                                        <i class="bi bi-plus-circle-fill"></i>
                                        Departman Ekle
                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>

                    <div class="col-xl-8">

                        <div class="nova-card">

                            <div class="nova-card-header">

                                <div>

                                    <h3 class="nova-card-title">
                                        Departman Listesi
                                    </h3>

                                    <div class="nova-card-subtitle">
                                        Toplam <%= departments.length %> departman
                                    </div>

                                </div>

                                <span class="nova-badge badge-blue">
                                    <i class="bi bi-building-fill"></i>
                                    <%= departments.length %>
                                </span>

                            </div>

                            <% if (departments.length > 0) { %>

                                <div class="nova-table-wrapper">

                                    <table class="nova-table">

                                        <thead>

                                            <tr>
                                                <th>#</th>
                                                <th>Departman</th>
                                                <th>Açıklama</th>
                                                <th>Tarih</th>
                                                <th>İşlemler</th>
                                            </tr>

                                        </thead>

                                        <tbody>

                                            <% departments.forEach((department, index) => { %>

                                                <tr>

                                                    <td>
                                                        <span class="text-nova-muted">
                                                            <%= index + 1 %>
                                                        </span>
                                                    </td>

                                                    <td>

                                                        <div class="person-cell">

                                                            <div class="person-avatar">
                                                                <i class="bi bi-building"></i>
                                                            </div>

                                                            <div>

                                                                <div class="person-name">
                                                                    <%= department.name %>
                                                                </div>

                                                                <div class="person-subtitle">
                                                                    Departman
                                                                </div>

                                                            </div>

                                                        </div>

                                                    </td>

                                                    <td>
                                                        <%= department.description || "Açıklama yok" %>
                                                    </td>

                                                    <td>
                                                        <%= department.created_at
                                                            ? new Date(department.created_at).toLocaleDateString("tr-TR")
                                                            : "-"
                                                        %>
                                                    </td>

                                                    <td>

                                                        <div class="table-actions">

                                                            <a
                                                                href="/departments/<%= department.id %>/edit"
                                                                class="btn-icon-nova btn-icon-edit"
                                                                title="Düzenle"
                                                            >
                                                                <i class="bi bi-pencil-fill"></i>
                                                            </a>

                                                            <form
                                                                action="/departments/<%= department.id %>/delete"
                                                                method="POST"
                                                                onsubmit="return confirm('Bu departmanı silmek istediğine emin misin?')"
                                                            >

                                                                <button
                                                                    type="submit"
                                                                    class="btn-icon-nova btn-icon-delete"
                                                                    title="Sil"
                                                                >
                                                                    <i class="bi bi-trash-fill"></i>
                                                                </button>

                                                            </form>

                                                        </div>

                                                    </td>

                                                </tr>

                                            <% }) %>

                                        </tbody>

                                    </table>

                                </div>

                            <% } else { %>

                                <div class="empty-state">

                                    <div class="empty-state-icon">
                                        <i class="bi bi-building"></i>
                                    </div>

                                    <h4 class="empty-state-title">
                                        Henüz departman bulunmuyor
                                    </h4>

                                    <p class="empty-state-text">
                                        Sol taraftaki formu kullanarak ilk departmanı ekleyebilirsiniz.
                                    </p>

                                </div>

                            <% } %>

                        </div>

                    </div>

                </div>

            </div>

            <%- include("partials/footer") %>

        </main>

    </div>

    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    ></script>

    <script src="/js/sidebar.js"></script>

</body>

</html>