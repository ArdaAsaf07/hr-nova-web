<%
    function formatDateForInput(dateValue) {
        if (!dateValue) {
            return "";
        }

        const date = new Date(dateValue);

        if (Number.isNaN(date.getTime())) {
            return "";
        }

        const year = date.getFullYear();
        const month = String(date.getMonth() + 1).padStart(2, "0");
        const day = String(date.getDate()).padStart(2, "0");

        return `${year}-${month}-${day}`;
    }
%>

<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>HR Nova | Eğitim Düzenle</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="/css/style.css"
    >
</head>

<body>

    <div class="hr-nova-layout">

        <%- include("partials/sidebar", {
            activePage: "trainings"
        }) %>

        <main class="main-content">

            <%- include("partials/topbar", {
                pageTitle: "Eğitim Düzenle"
            }) %>

            <div class="content-wrapper">

                <div class="page-header">

                    <div class="page-header-left">

                        <h2 class="page-title">
                            Eğitim Kaydını Düzenle
                        </h2>

                        <p class="page-description">
                            Eğitim bilgilerini güncelleyin ve kaydedin.
                        </p>

                    </div>

                    <div class="page-actions">

                        <a
                            href="/trainings"
                            class="btn-nova btn-secondary-nova"
                        >
                            <i class="bi bi-arrow-left"></i>
                            Eğitimlere Dön
                        </a>

                    </div>

                </div>

                <% if (error) { %>

                    <div class="alert-nova alert-danger-nova">

                        <i class="bi bi-exclamation-circle-fill"></i>

                        <div>
                            <%= error %>
                        </div>

                    </div>

                <% } %>

                <div class="form-card">

                    <form
                        action="/trainings/<%= training.id %>/edit"
                        method="POST"
                    >

                        <div class="form-section">

                            <h3 class="form-section-title">
                                Temel Bilgiler
                            </h3>

                            <p class="form-section-description">
                                Eğitimin adı ve atanacağı personeli belirleyin.
                            </p>

                            <div class="row g-4">

                                <div class="col-md-6">

                                    <label class="form-label-nova">
                                        Eğitim Adı
                                        <span class="form-required">*</span>
                                    </label>

                                    <input
                                        type="text"
                                        name="name"
                                        class="form-control-nova"
                                        value="<%= training.name %>"
                                        required
                                    >

                                </div>

                                <div class="col-md-6">

                                    <label class="form-label-nova">
                                        Personel
                                        <span class="form-required">*</span>
                                    </label>

                                    <select
                                        name="employee_id"
                                        class="form-select-nova"
                                        required
                                    >

                                        <option value="">
                                            Personel seçin
                                        </option>

                                        <% employees.forEach(employee => { %>

                                            <option
                                                value="<%= employee.id %>"
                                                <%= Number(employee.id) === Number(training.employee_id)
                                                    ? "selected"
                                                    : ""
                                                %>
                                            >
                                                <%= employee.first_name %>
                                                <%= employee.last_name %>
                                            </option>

                                        <% }) %>

                                    </select>

                                </div>

                            </div>

                        </div>

                        <div class="form-section">

                            <h3 class="form-section-title">
                                Tarih ve Süre
                            </h3>

                            <p class="form-section-description">
                                Eğitimin tarihlerini, süresini ve durumunu güncelleyin.
                            </p>

                            <div class="row g-4">

                                <div class="col-md-6">

                                    <label class="form-label-nova">
                                        Başlangıç Tarihi
                                        <span class="form-required">*</span>
                                    </label>

                                    <input
                                        type="date"
                                        name="start_date"
                                        class="form-control-nova"
                                        value="<%= formatDateForInput(training.start_date) %>"
                                        required
                                    >

                                </div>

                                <div class="col-md-6">

                                    <label class="form-label-nova">
                                        Bitiş Tarihi
                                    </label>

                                    <input
                                        type="date"
                                        name="end_date"
                                        class="form-control-nova"
                                        value="<%= formatDateForInput(training.end_date) %>"
                                    >

                                </div>

                                <div class="col-md-6">

                                    <label class="form-label-nova">
                                        Eğitim Süresi
                                    </label>

                                    <input
                                        type="number"
                                        name="duration"
                                        class="form-control-nova"
                                        min="1"
                                        value="<%= training.duration || "" %>"
                                        placeholder="Saat"
                                    >

                                </div>

                                <div class="col-md-6">

                                    <label class="form-label-nova">
                                        Durum
                                    </label>

                                    <select
                                        name="status"
                                        class="form-select-nova"
                                    >

                                        <option
                                            value="Planlandı"
                                            <%= training.status === "Planlandı"
                                                ? "selected"
                                                : ""
                                            %>
                                        >
                                            Planlandı
                                        </option>

                                        <option
                                            value="Devam Ediyor"
                                            <%= training.status === "Devam Ediyor"
                                                ? "selected"
                                                : ""
                                            %>
                                        >
                                            Devam Ediyor
                                        </option>

                                        <option
                                            value="Tamamlandı"
                                            <%= training.status === "Tamamlandı"
                                                ? "selected"
                                                : ""
                                            %>
                                        >
                                            Tamamlandı
                                        </option>

                                        <option
                                            value="Süresi Doldu"
                                            <%= training.status === "Süresi Doldu"
                                                ? "selected"
                                                : ""
                                            %>
                                        >
                                            Süresi Doldu
                                        </option>

                                    </select>

                                </div>

                            </div>

                        </div>

                        <div class="form-section">

                            <h3 class="form-section-title">
                                Açıklama
                            </h3>

                            <p class="form-section-description">
                                Eğitimle ilgili ek bilgileri yazabilirsiniz.
                            </p>

                            <textarea
                                name="description"
                                class="form-control-nova"
                                placeholder="Eğitim hakkında açıklama..."
                            ><%= training.description || "" %></textarea>

                        </div>

                        <div class="form-actions">

                            <a
                                href="/trainings"
                                class="btn-nova btn-secondary-nova"
                            >
                                Vazgeç
                            </a>

                            <button
                                type="submit"
                                class="btn-nova btn-primary-nova"
                            >
                                <i class="bi bi-check-circle-fill"></i>
                                Değişiklikleri Kaydet
                            </button>

                        </div>

                    </form>

                </div>

            </div>

            <%- include("partials/footer") %>

        </main>

    </div>

    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    ></script>

    <script src="/js/sidebar.js"></script>

</body>

</html>