<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HR Nova | Mail Merkezi</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="hr-nova-layout">
        <%- include("partials/sidebar", { activePage: "mail" }) %>
        <main class="main-content">
            <%- include("partials/topbar", { pageTitle: "Mail Merkezi" }) %>
            <div class="content-wrapper">
                <div class="page-header">
                    <div class="page-header-left">
                        <h2 class="page-title">Mail Merkezi</h2>
                        <p class="page-description">Personele güvenli mail gönderin ve geçmişi takip edin.</p>
                    </div>
                </div>

                <% if (!mailConfigured) { %>
                    <div class="alert-nova alert-danger-nova"><i class="bi bi-exclamation-triangle-fill"></i><div>SMTP ayarları tamamlanmadı. Mail gönderimi devre dışı.</div></div>
                <% } %>
                <% if (success) { %><div class="alert-nova alert-success-nova"><i class="bi bi-check-circle-fill"></i><div><%= success %></div></div><% } %>
                <% if (error) { %><div class="alert-nova alert-danger-nova"><i class="bi bi-exclamation-circle-fill"></i><div><%= error %></div></div><% } %>

                <div class="row g-4">
                    <div class="col-xl-5">
                        <div class="form-card"><div class="form-section">
                            <h3 class="form-section-title">Yeni Mail</h3>
                            <form action="/mail/send" method="POST">
                                <%- include("partials/csrf") %>
                                <div class="mb-3"><label class="form-label-nova">Personel (isteğe bağlı)</label><select name="employee_id" class="form-control-nova"><option value="">Personel seçmeden gönder</option><% employees.forEach(employee => { %><option value="<%= employee.id %>"><%= employee.first_name %> <%= employee.last_name %> — <%= employee.email %></option><% }) %></select></div>
                                <div class="mb-3"><label class="form-label-nova">Doğrudan alıcı e-posta (kendine test için)</label><input type="email" name="recipient_email" class="form-control-nova" maxlength="320" placeholder="ornek@mail.com"><small>Buraya adres yazarsanız personel seçimini geçersiz kılar.</small></div>
                                <div class="mb-3"><label class="form-label-nova">Konu</label><input name="subject" class="form-control-nova" maxlength="255" required></div>
                                <div class="mb-4"><label class="form-label-nova">Mesaj</label><textarea name="message" class="form-control-nova" rows="8" maxlength="10000" required></textarea></div>
                                <button class="btn-nova btn-primary-nova w-100" type="submit" <%= mailConfigured ? "" : "disabled" %>><i class="bi bi-send-fill"></i> Mail Gönder</button>
                            </form>
                        </div></div>
                    </div>
                    <div class="col-xl-7">
                        <div class="nova-card"><div class="nova-card-header"><div><h3 class="nova-card-title"><%= archiveView ? 'Arşiv' : 'Gönderim Geçmişi' %></h3><div class="nova-card-subtitle">Son 50 gönderim</div></div><a class="btn-nova" href="/mail<%= archiveView?'':'?view=archive' %>"><%= archiveView?'Gönderilenlere dön':'Arşivi aç' %></a></div>
                            <div class="nova-table-wrapper"><table class="nova-table"><thead><tr><th>Alıcı</th><th>Konu</th><th>Durum</th><th>Tarih</th><th>İşlem</th></tr></thead><tbody>
                                <% history.forEach(item => { %><tr><td><%= item.recipient_email %></td><td><%= item.subject %></td><td><span class="nova-badge <%= item.status === 'sent' ? 'badge-green' : 'badge-red' %>"><%= item.status === 'sent' ? 'Gönderildi' : 'Başarısız' %></span></td><td><%= new Date(item.created_at).toLocaleString('tr-TR') %></td><td><div class="d-flex gap-1"><form method="POST" action="/mail/<%= item.id %>/<%= archiveView?'restore':'archive' %>"><%- include('partials/csrf') %><button class="btn btn-sm btn-outline-secondary"><%= archiveView?'Geri al':'Arşivle' %></button></form><form method="POST" action="/mail/<%= item.id %>/delete"><%- include('partials/csrf') %><input type="hidden" name="from_archive" value="<%= archiveView?'1':'0' %>"><button class="btn btn-sm btn-outline-danger" onclick="return confirm('Bu kaydı silmek istiyor musunuz?')">Sil</button></form></div></td></tr><% }) %>
                                <% if (history.length === 0) { %><tr><td colspan="5">Bu bölümde mail kaydı yok.</td></tr><% } %>
                            </tbody></table></div>
                        </div>
                    </div>
                </div>
            </div>
            <%- include("partials/footer") %>
        </main>
    </div>
    <script src="/js/sidebar.js"></script>
</body>
</html>
