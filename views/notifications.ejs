<!DOCTYPE html><html lang="tr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>HR Nova | Bildirimler</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet"><link rel="stylesheet" href="/css/style.css"></head><body><div class="hr-nova-layout"><%- include("partials/sidebar", { activePage: "notifications" }) %><main class="main-content"><%- include("partials/topbar", { pageTitle: "Bildirimler" }) %><div class="content-wrapper"><div class="page-header"><div class="page-header-left"><h2 class="page-title">Bildirimler</h2><p class="page-description">Yaklaşan ve süresi geçen eğitimler otomatik listelenir.</p></div></div><div class="nova-card"><div class="nova-card-header"><div><h3 class="nova-card-title">Eğitim Uyarıları</h3><div class="nova-card-subtitle">Önümüzdeki 30 gün ve geciken kayıtlar</div></div></div><div class="nova-table-wrapper"><table class="nova-table"><thead><tr><th>Durum</th><th>Eğitim</th><th>Personel</th><th>Tarih</th></tr></thead><tbody><% notifications.forEach(item => { %><tr><td><span class="nova-badge <%= item.type === 'expired' ? 'badge-red' : 'badge-yellow' %>"><%= item.type === 'expired' ? 'Süresi geçti' : 'Yaklaşıyor' %></span></td><td><%= item.title %></td><td><%= item.employee_name || 'Atanmamış' %></td><td><%= item.event_date ? new Date(item.event_date).toLocaleDateString('tr-TR') : '-' %></td></tr><% }) %><% if (!notifications.length) { %><tr><td colspan="4">Şu anda bildirim gerektiren bir kayıt yok.</td></tr><% } %></tbody></table></div></div></div><%- include("partials/footer") %></main></div><script src="/js/sidebar.js"></script></body></html>
