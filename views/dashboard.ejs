<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>HR Nova</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
        rel="stylesheet">

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<div class="app-wrapper">

    <aside class="sidebar">
        <div class="brand-area">
            <div class="brand-icon">
                <i class="bi bi-people-fill"></i>
            </div>

            <div>
                <h4>HR Nova</h4>
                <span>İnsan Kaynakları</span>
            </div>
        </div>

        <nav class="sidebar-menu">

            <a href="#" class="menu-link active">
                <i class="bi bi-house-door"></i>
                <span>Ana Sayfa</span>
            </a>

            <a href="#" class="menu-link">
                <i class="bi bi-people"></i>
                <span>Personeller</span>
            </a>

            <a href="#" class="menu-link">
                <i class="bi bi-diagram-3"></i>
                <span>Departmanlar</span>
            </a>

            <a href="#" class="menu-link">
                <i class="bi bi-mortarboard"></i>
                <span>Eğitimler</span>
            </a>

            <a href="#" class="menu-link">
                <i class="bi bi-calendar-event"></i>
                <span>Yaklaşan Eğitimler</span>
            </a>

            <a href="#" class="menu-link">
                <i class="bi bi-bar-chart"></i>
                <span>Raporlar</span>
            </a>

            <a href="#" class="menu-link">
                <i class="bi bi-file-earmark-excel"></i>
                <span>Excel Aktarma</span>
            </a>

            <a href="#" class="menu-link">
                <i class="bi bi-envelope"></i>
                <span>E-Posta</span>
            </a>

            <a href="#" class="menu-link">
                <i class="bi bi-gear"></i>
                <span>Ayarlar</span>
            </a>

        </nav>

        <a href="#" class="logout-link">
            <i class="bi bi-box-arrow-left"></i>
            <span>Çıkış Yap</span>
        </a>
    </aside>

    <div class="main-area">

        <header class="topbar">

            <button class="mobile-menu-button">
                <i class="bi bi-list"></i>
            </button>

            <div class="topbar-title">
               
            </div>

            <div class="user-area">
                <div class="user-avatar">
                    SY
                </div>

                <div class="user-info">
                    <strong>Sistem Yöneticisi</strong>
                    <span>Yönetici</span>
                </div>

                <i class="bi bi-chevron-down"></i>
            </div>

        </header>

        <main class="content-area">

            <div class="page-header">
                <div>
                    <h1>Ana Sayfa</h1>
                    <p>Şirketinizin insan kaynakları süreçlerini buradan yönetin.</p>
                </div>

                <div class="date-box">
                    <i class="bi bi-calendar3"></i>
                    <span>17 Temmuz 2026</span>
                </div>
            </div>

            <section class="welcome-card">

                <div class="welcome-content">
                    <span class="welcome-badge">HR Nova</span>

                    <h2>Hoş geldiniz, Sistem Yöneticisi 👋</h2>

                    <p>
                        Personel, departman ve eğitim süreçlerini tek bir panelden
                        kolayca takip edebilirsiniz.
                    </p>

                    <a href="#" class="btn btn-light">
                        Personelleri Görüntüle
                        <i class="bi bi-arrow-right ms-2"></i>
                    </a>
                </div>

                <div class="welcome-icon">
                    <i class="bi bi-person-workspace"></i>
                </div>

            </section>

            <section class="row g-4 mt-1">

                <div class="col-xl-4 col-md-6">
                    <div class="stat-card">
                        <div class="stat-icon icon-blue">
                            <i class="bi bi-people-fill"></i>
                        </div>

                        <div class="stat-content">
                            <span>Toplam Personel</span>
                            <h3>0</h3>
                            <small>
                                <i class="bi bi-arrow-up-right"></i>
                                Güncel personel sayısı
                            </small>
                        </div>
                    </div>
                </div>

                <div class="col-xl-4 col-md-6">
                    <div class="stat-card">
                        <div class="stat-icon icon-orange">
                            <i class="bi bi-calendar-check"></i>
                        </div>

                        <div class="stat-content">
                            <span>Yaklaşan Eğitimler</span>
                            <h3>0</h3>
                            <small>
                                <i class="bi bi-clock"></i>
                                Yaklaşan eğitim bulunmuyor
                            </small>
                        </div>
                    </div>
                </div>

                <div class="col-xl-4 col-md-6">
                    <div class="stat-card">
                        <div class="stat-icon icon-red">
                            <i class="bi bi-exclamation-triangle"></i>
                        </div>

                        <div class="stat-content">
                            <span>Eğitimi Eksik Personel</span>
                            <h3>0</h3>
                            <small>
                                <i class="bi bi-check-circle"></i>
                                Tüm kayıtlar güncel
                            </small>
                        </div>
                    </div>
                </div>

            </section>

            <section class="row g-4 mt-2">

                <div class="col-xl-8">
                    <div class="content-card">

                        <div class="card-header-custom">
                            <div>
                                <h4>Departman Dağılımı</h4>
                                <p>Departmanlara göre personel sayıları</p>
                            </div>

                            <a href="#">Tümünü Gör</a>
                        </div>

                        <div class="empty-state">
                            <i class="bi bi-pie-chart"></i>
                            <h5>Henüz personel verisi yok</h5>
                            <p>Personel eklendiğinde departman dağılımı burada görünecek.</p>
                        </div>

                    </div>
                </div>

                <div class="col-xl-4">
                    <div class="content-card">

                        <div class="card-header-custom">
                            <div>
                                <h4>Hızlı İşlemler</h4>
                                <p>Sık kullanılan işlemler</p>
                            </div>
                        </div>

                        <div class="quick-actions">

                            <a href="#">
                                <div class="quick-icon">
                                    <i class="bi bi-person-plus"></i>
                                </div>

                                <div>
                                    <strong>Personel Ekle</strong>
                                    <span>Yeni personel kaydı oluştur</span>
                                </div>
                            </a>

                            <a href="#">
                                <div class="quick-icon">
                                    <i class="bi bi-diagram-3"></i>
                                </div>

                                <div>
                                    <strong>Departman Ekle</strong>
                                    <span>Yeni departman oluştur</span>
                                </div>
                            </a>

                            <a href="#">
                                <div class="quick-icon">
                                    <i class="bi bi-file-earmark-excel"></i>
                                </div>

                                <div>
                                    <strong>Excel Aktar</strong>
                                    <span>Personelleri toplu aktar</span>
                                </div>
                            </a>

                        </div>

                    </div>
                </div>

            </section>

        </main>

    </div>

</div>

</body>
</html>