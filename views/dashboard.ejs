<%
    const employeeTotal =
        typeof totalEmployees !== "undefined" ? totalEmployees :
        typeof employeeCount !== "undefined" ? employeeCount : 0;

    const departmentTotal =
        typeof totalDepartments !== "undefined" ? totalDepartments :
        typeof departmentCount !== "undefined" ? departmentCount : 0;

    const upcomingTrainingTotal =
        typeof upcomingTrainingCount !== "undefined"
            ? upcomingTrainingCount
            : typeof upcomingTrainings !== "undefined" && !Array.isArray(upcomingTrainings)
                ? upcomingTrainings
                : 0;

    const expiredTrainingTotal =
        typeof expiredTrainings !== "undefined" && !Array.isArray(expiredTrainings)
            ? expiredTrainings
            : 0;

    const missingTrainingTotal =
        typeof missingTrainings !== "undefined" ? missingTrainings : 0;

    const certificateTotal =
        typeof totalCertificates !== "undefined" ? totalCertificates : 0;

    const recentEmployeeList =
        typeof recentEmployees !== "undefined" && Array.isArray(recentEmployees)
            ? recentEmployees
            : typeof employees !== "undefined" && Array.isArray(employees)
                ? employees.slice(0, 5)
                : [];

    const upcomingTrainingList =
        typeof upcomingTrainingRecords !== "undefined" && Array.isArray(upcomingTrainingRecords)
            ? upcomingTrainingRecords
            : typeof upcomingTrainings !== "undefined" && Array.isArray(upcomingTrainings)
                ? upcomingTrainings
                : [];
%>

<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>HR Nova | Ana Sayfa</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="/css/style.css"
    >
</head>

<body>

    <div class="hr-nova-layout">

        <%- include("partials/sidebar", {
            activePage: "dashboard"
        }) %>

        <main class="main-content">

            <%- include("partials/topbar", {
                pageTitle: "Ana Sayfa"
            }) %>

            <div class="content-wrapper">

                <!-- Sayfa başlığı -->
                <div class="page-header">

                    <div class="page-header-left">

                        <h2 class="page-title">
                            Hoş Geldiniz 👋
                        </h2>

                        <p class="page-description">
                            Personel, departman ve eğitim süreçlerini tek ekrandan yönetin.
                        </p>

                    </div>

                    <div class="page-actions">

                        <a
                            href="/employees/new"
                            class="btn-nova btn-primary-nova"
                        >
                            <i class="bi bi-person-plus-fill"></i>
                            Personel Ekle
                        </a>

                    </div>

                </div>

                <!-- İstatistik kartları -->
                <div class="row g-4 mb-4">

                    <div class="col-xl-4 col-md-6">

                        <div class="stat-card">

                            <div class="stat-card-inner">

                                <div>

                                    <div class="stat-card-label">
                                        Toplam Personel
                                    </div>

                                    <h3 class="stat-card-value">
                                        <%= employeeTotal %>
                                    </h3>

                                    <div class="stat-card-description">
                                        Sistemde kayıtlı personeller
                                    </div>

                                </div>

                                <div class="stat-icon blue">
                                    <i class="bi bi-people-fill"></i>
                                </div>

                            </div>

                        </div>

                    </div>

                    <div class="col-xl-4 col-md-6">

                        <div class="stat-card">

                            <div class="stat-card-inner">

                                <div>

                                    <div class="stat-card-label">
                                        Departmanlar
                                    </div>

                                    <h3 class="stat-card-value">
                                        <%= departmentTotal %>
                                    </h3>

                                    <div class="stat-card-description">
                                        Aktif organizasyon birimleri
                                    </div>

                                </div>

                                <div class="stat-icon purple">
                                    <i class="bi bi-diagram-3-fill"></i>
                                </div>

                            </div>

                        </div>

                    </div>

                    <div class="col-xl-4 col-md-6">

                        <div class="stat-card">

                            <div class="stat-card-inner">

                                <div>

                                    <div class="stat-card-label">
                                        Yaklaşan Eğitimler
                                    </div>

                                    <h3 class="stat-card-value">
                                        <%= upcomingTrainingTotal %>
                                    </h3>

                                    <div class="stat-card-description">
                                        Yakında başlayacak eğitimler
                                    </div>

                                </div>

                                <div class="stat-icon green">
                                    <i class="bi bi-calendar-check-fill"></i>
                                </div>

                            </div>

                        </div>

                    </div>

                    <div class="col-xl-4 col-md-6">

                        <div class="stat-card">

                            <div class="stat-card-inner">

                                <div>

                                    <div class="stat-card-label">
                                        Süresi Dolan Eğitim
                                    </div>

                                    <h3 class="stat-card-value">
                                        <%= expiredTrainingTotal %>
                                    </h3>

                                    <div class="stat-card-description">
                                        Yenilenmesi gereken eğitimler
                                    </div>

                                </div>

                                <div class="stat-icon red">
                                    <i class="bi bi-exclamation-triangle-fill"></i>
                                </div>

                            </div>

                        </div>

                    </div>

                    <div class="col-xl-4 col-md-6">

                        <div class="stat-card">

                            <div class="stat-card-inner">

                                <div>

                                    <div class="stat-card-label">
                                        Eksik Eğitim
                                    </div>

                                    <h3 class="stat-card-value">
                                        <%= missingTrainingTotal %>
                                    </h3>

                                    <div class="stat-card-description">
                                        Eğitimi eksik personeller
                                    </div>

                                </div>

                                <div class="stat-icon orange">
                                    <i class="bi bi-journal-x"></i>
                                </div>

                            </div>

                        </div>

                    </div>

                    <div class="col-xl-4 col-md-6">

                        <div class="stat-card">

                            <div class="stat-card-inner">

                                <div>

                                    <div class="stat-card-label">
                                        Sertifikalar
                                    </div>

                                    <h3 class="stat-card-value">
                                        <%= certificateTotal %>
                                    </h3>

                                    <div class="stat-card-description">
                                        Kayıtlı personel sertifikaları
                                    </div>

                                </div>

                                <div class="stat-icon green">
                                    <i class="bi bi-award-fill"></i>
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <div class="row g-4">

                    <!-- Son eklenen personeller -->
                    <div class="col-xl-8">

                        <div class="nova-card h-100">

                            <div class="nova-card-header">

                                <div>

                                    <h3 class="nova-card-title">
                                        Son Eklenen Personeller
                                    </h3>

                                    <div class="nova-card-subtitle">
                                        Sisteme en son kaydedilen personeller
                                    </div>

                                </div>

                                <a
                                    href="/employees"
                                    class="btn-nova btn-secondary-nova btn-sm-nova"
                                >
                                    Tümünü Gör
                                    <i class="bi bi-arrow-right"></i>
                                </a>

                            </div>

                            <% if (recentEmployeeList.length > 0) { %>

                                <div class="nova-table-wrapper">

                                    <table class="nova-table">

                                        <thead>

                                            <tr>
                                                <th>Personel</th>
                                                <th>Departman</th>
                                                <th>Pozisyon</th>
                                                <th>İşe Giriş</th>
                                            </tr>

                                        </thead>

                                        <tbody>

                                            <% recentEmployeeList.forEach(employee => { %>

                                                <%
                                                    const firstName =
                                                        employee.first_name ||
                                                        employee.firstName ||
                                                        employee.ad ||
                                                        "";

                                                    const lastName =
                                                        employee.last_name ||
                                                        employee.lastName ||
                                                        employee.soyad ||
                                                        "";

                                                    const initials =
                                                        `${firstName.charAt(0)}${lastName.charAt(0)}`.toUpperCase();

                                                    const departmentName =
                                                        employee.department_name ||
                                                        employee.departmentName ||
                                                        employee.departman_adi ||
                                                        "Atanmadı";

                                                    const positionName =
                                                        employee.position ||
                                                        employee.pozisyon ||
                                                        "Belirtilmedi";

                                                    const hireDate =
                                                        employee.hire_date ||
                                                        employee.hireDate ||
                                                        employee.ise_giris_tarihi;
                                                %>

                                                <tr>

                                                    <td>

                                                        <div class="person-cell">

                                                            <div class="person-avatar">
                                                                <%= initials || "P" %>
                                                            </div>

                                                            <div>

                                                                <div class="person-name">
                                                                    <%= firstName %> <%= lastName %>
                                                                </div>

                                                                <div class="person-subtitle">
                                                                    <%= employee.email || "E-posta bulunmuyor" %>
                                                                </div>

                                                            </div>

                                                        </div>

                                                    </td>

                                                    <td>
                                                        <span class="nova-badge badge-blue">
                                                            <%= departmentName %>
                                                        </span>
                                                    </td>

                                                    <td>
                                                        <%= positionName %>
                                                    </td>

                                                    <td>
                                                        <%= hireDate
                                                            ? new Date(hireDate).toLocaleDateString("tr-TR")
                                                            : "-"
                                                        %>
                                                    </td>

                                                </tr>

                                            <% }) %>

                                        </tbody>

                                    </table>

                                </div>

                            <% } else { %>

                                <div class="empty-state">

                                    <div class="empty-state-icon">
                                        <i class="bi bi-people"></i>
                                    </div>

                                    <h4 class="empty-state-title">
                                        Henüz personel bulunmuyor
                                    </h4>

                                    <p class="empty-state-text">
                                        İlk personel kaydını oluşturarak sistemi kullanmaya başlayabilirsiniz.
                                    </p>

                                    <a
                                        href="/employees/new"
                                        class="btn-nova btn-primary-nova"
                                    >
                                        <i class="bi bi-person-plus-fill"></i>
                                        Personel Ekle
                                    </a>

                                </div>

                            <% } %>

                        </div>

                    </div>

                    <!-- Hızlı işlemler -->
                    <div class="col-xl-4">

                        <div class="nova-card mb-4">

                            <div class="nova-card-header">

                                <div>

                                    <h3 class="nova-card-title">
                                        Hızlı İşlemler
                                    </h3>

                                    <div class="nova-card-subtitle">
                                        Sık kullanılan işlemler
                                    </div>

                                </div>

                            </div>

                            <div class="nova-card-body">

                                <div class="d-grid gap-2">

                                    <a
                                        href="/employees/new"
                                        class="btn-nova btn-primary-nova justify-content-start"
                                    >
                                        <i class="bi bi-person-plus-fill"></i>
                                        Yeni Personel Ekle
                                    </a>

                                    <a
                                        href="/departments"
                                        class="btn-nova btn-secondary-nova justify-content-start"
                                    >
                                        <i class="bi bi-diagram-3-fill"></i>
                                        Departmanları Yönet
                                    </a>

                                    <a
                                        href="/trainings"
                                        class="btn-nova btn-secondary-nova justify-content-start"
                                    >
                                        <i class="bi bi-mortarboard-fill"></i>
                                        Eğitim Oluştur
                                    </a>

                                    <a
                                        href="/excel"
                                        class="btn-nova btn-secondary-nova justify-content-start"
                                    >
                                        <i class="bi bi-file-earmark-excel-fill"></i>
                                        Excel'den Personel Aktar
                                    </a>

                                    <a
                                        href="/mail"
                                        class="btn-nova btn-secondary-nova justify-content-start"
                                    >
                                        <i class="bi bi-envelope-fill"></i>
                                        Mail Gönder
                                    </a>

                                </div>

                            </div>

                        </div>

                        <!-- Sistem durumu -->
                        <div class="nova-card">

                            <div class="nova-card-header">

                                <div>

                                    <h3 class="nova-card-title">
                                        Sistem Durumu
                                    </h3>

                                    <div class="nova-card-subtitle">
                                        HR Nova servis bilgileri
                                    </div>

                                </div>

                                <span class="nova-badge badge-green">
                                    <i class="bi bi-circle-fill"></i>
                                    Aktif
                                </span>

                            </div>

                            <div class="nova-card-body">

                                <div class="notification-item">

                                    <div class="notification-icon stat-icon green">
                                        <i class="bi bi-database-check"></i>
                                    </div>

                                    <div class="notification-content">

                                        <div class="notification-title">
                                            Veritabanı bağlantısı
                                        </div>

                                        <div class="notification-description">
                                            Neon PostgreSQL bağlantısı aktif.
                                        </div>

                                    </div>

                                </div>

                                <div class="notification-item">

                                    <div class="notification-icon stat-icon blue">
                                        <i class="bi bi-shield-check"></i>
                                    </div>

                                    <div class="notification-content">

                                        <div class="notification-title">
                                            Sistem güvenliği
                                        </div>

                                        <div class="notification-description">
                                            Sistem normal şekilde çalışıyor.
                                        </div>

                                    </div>

                                </div>

                                <div class="notification-item">

                                    <div class="notification-icon stat-icon purple">
                                        <i class="bi bi-cloud-check"></i>
                                    </div>

                                    <div class="notification-content">

                                        <div class="notification-title">
                                            Bulut sistemi
                                        </div>

                                        <div class="notification-description">
                                            Veriler bulut veritabanında saklanıyor.
                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- Yaklaşan eğitimler -->
                <div class="nova-card mt-4">

                    <div class="nova-card-header">

                        <div>

                            <h3 class="nova-card-title">
                                Yaklaşan Eğitimler
                            </h3>

                            <div class="nova-card-subtitle">
                                Planlanan personel eğitimleri
                            </div>

                        </div>

                        <a
                            href="/trainings"
                            class="btn-nova btn-secondary-nova btn-sm-nova"
                        >
                            Eğitimlere Git
                            <i class="bi bi-arrow-right"></i>
                        </a>

                    </div>

                    <% if (upcomingTrainingList.length > 0) { %>

                        <div class="nova-table-wrapper">

                            <table class="nova-table">

                                <thead>

                                    <tr>
                                        <th>Eğitim</th>
                                        <th>Personel</th>
                                        <th>Başlangıç</th>
                                        <th>Bitiş</th>
                                        <th>Durum</th>
                                    </tr>

                                </thead>

                                <tbody>

                                    <% upcomingTrainingList.forEach(training => { %>

                                        <tr>

                                            <td class="fw-700">
                                                <%= training.name || training.training_name || training.title || "-" %>
                                            </td>

                                            <td>
                                                <%= training.employee_name || training.personnel_name || "-" %>
                                            </td>

                                            <td>
                                                <%= training.start_date
                                                    ? new Date(training.start_date).toLocaleDateString("tr-TR")
                                                    : "-"
                                                %>
                                            </td>

                                            <td>
                                                <%= training.end_date
                                                    ? new Date(training.end_date).toLocaleDateString("tr-TR")
                                                    : "-"
                                                %>
                                            </td>

                                            <td>
                                                <span class="nova-badge badge-orange">
                                                    Yaklaşıyor
                                                </span>
                                            </td>

                                        </tr>

                                    <% }) %>

                                </tbody>

                            </table>

                        </div>

                    <% } else { %>

                        <div class="empty-state">

                            <div class="empty-state-icon">
                                <i class="bi bi-calendar2-check"></i>
                            </div>

                            <h4 class="empty-state-title">
                                Yaklaşan eğitim bulunmuyor
                            </h4>

                            <p class="empty-state-text">
                                Yeni eğitim planladığınızda burada görüntülenecektir.
                            </p>

                            <a
                                href="/trainings"
                                class="btn-nova btn-primary-nova"
                            >
                                <i class="bi bi-plus-lg"></i>
                                Eğitim Oluştur
                            </a>

                        </div>

                    <% } %>

                </div>

            </div>

            <%- include("partials/footer") %>

        </main>

    </div>

    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    ></script>

    <script src="/js/sidebar.js"></script>

</body>

</html>
