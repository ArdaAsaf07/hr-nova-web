<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HR Nova | Yönetici Girişi</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-light">
    <main class="container min-vh-100 d-flex align-items-center justify-content-center py-5">
        <div class="form-card w-100" style="max-width: 480px;">
            <div class="form-section p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="person-avatar mx-auto mb-3">
                        <i class="bi bi-shield-lock-fill"></i>
                    </div>
                    <h1 class="page-title mb-2">HR Nova</h1>
                    <p class="page-description mb-0">Yönetici hesabınızla güvenli giriş yapın.</p>
                </div>

                <% if (error) { %>
                    <div class="alert-nova alert-danger-nova mb-4">
                        <i class="bi bi-exclamation-circle-fill"></i>
                        <div><%= error %></div>
                    </div>
                <% } %>

                <form action="/login" method="POST">
                    <div class="mb-3">
                        <label for="username" class="form-label-nova">Kullanıcı Adı</label>
                        <input id="username" name="username" type="text" class="form-control-nova" autocomplete="username" maxlength="50" required autofocus>
                    </div>
                    <div class="mb-4">
                        <label for="password" class="form-label-nova">Parola</label>
                        <input id="password" name="password" type="password" class="form-control-nova" autocomplete="current-password" required>
                    </div>
                    <button type="submit" class="btn-nova btn-primary-nova w-100">
                        <i class="bi bi-box-arrow-in-right"></i>
                        Giriş Yap
                    </button>
                </form>
            </div>
        </div>
    </main>
</body>
</html>
