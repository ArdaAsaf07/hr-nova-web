<!DOCTYPE html><html lang="tr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>HR Nova | Personeller</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet"><link rel="stylesheet" href="/css/style.css"></head><body>
<div class="hr-nova-layout"><%- include('partials/sidebar',{activePage:'employees'}) %><main class="main-content"><%- include('partials/topbar',{pageTitle:'Personeller'}) %><div class="content-wrapper">
<div class="page-header"><div><h2 class="page-title">Personel Yönetimi</h2><p class="page-description">Çalışan bilgilerini görüntüleyin, arayın ve güncelleyin.</p></div><a href="/employees/new" class="btn-nova btn-primary-nova"><i class="bi bi-person-plus-fill"></i> Yeni Personel</a></div>
<% if(success){ %><div class="alert alert-success"><i class="bi bi-check-circle-fill me-2"></i><%= success %></div><% } %><% if(error){ %><div class="alert alert-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %></div><% } %>
<% const departmentCount=new Set(employees.map(x=>x.department_name).filter(Boolean)).size; const trainedCount=employees.filter(x=>x.education_status==='Aldı').length; %>
<div class="row g-3 mb-4"><div class="col-md-4"><div class="nova-card p-4"><i class="bi bi-people-fill fs-3 text-primary"></i><small class="d-block mt-2 text-muted">Toplam Personel</small><h2 class="mb-0"><%= employees.length %></h2></div></div><div class="col-md-4"><div class="nova-card p-4"><i class="bi bi-diagram-3-fill fs-3 text-success"></i><small class="d-block mt-2 text-muted">Aktif Departman</small><h2 class="mb-0"><%= departmentCount %></h2></div></div><div class="col-md-4"><div class="nova-card p-4"><i class="bi bi-mortarboard-fill fs-3 text-warning"></i><small class="d-block mt-2 text-muted">Eğitim Aldı</small><h2 class="mb-0"><%= trainedCount %></h2></div></div></div>
<div class="nova-card"><div class="nova-card-header flex-wrap gap-3"><div><h3 class="nova-card-title">Personel Listesi</h3><div class="nova-card-subtitle"><%= employees.length %> kayıt</div></div><div style="min-width:280px"><input id="employeeSearch" type="search" class="form-control-nova" placeholder="Ad, departman veya pozisyon ara..."></div></div>
<% if(employees.length){ %><div class="nova-table-wrapper"><table class="nova-table"><thead><tr><th>Personel</th><th>Departman</th><th>Pozisyon</th><th>Cinsiyet</th><th>Eğitim</th><th>İşe Giriş</th><th>İşlemler</th></tr></thead><tbody><% employees.forEach(employee=>{ const searchText=`${employee.first_name} ${employee.last_name} ${employee.email||''} ${employee.department_name||''} ${employee.position||''}`.toLocaleLowerCase('tr-TR'); %><tr class="employee-row" data-search="<%= searchText %>"><td><div class="fw-semibold"><%= employee.first_name %> <%= employee.last_name %></div><small class="text-muted"><%= employee.email||'E-posta yok' %></small></td><td><span class="nova-badge badge-blue"><%= employee.department_name||'Departmansız' %></span></td><td><%= employee.position||'-' %></td><td><%= employee.gender||'-' %></td><td><span class="nova-badge <%= employee.education_status==='Aldı'?'badge-green':employee.education_status==='Almadı'?'badge-red':'badge-gray' %>"><%= employee.education_status||'Belirtilmedi' %></span></td><td><%= employee.hire_date?new Date(employee.hire_date).toLocaleDateString('tr-TR'):'-' %></td><td><div class="d-flex gap-2"><a href="/employees/<%= employee.id %>/edit" class="btn btn-sm btn-outline-primary" title="Düzenle"><i class="bi bi-pencil-square"></i></a><form action="/employees/<%= employee.id %>/delete" method="POST" onsubmit="return confirm('<%= employee.first_name %> <%= employee.last_name %> kalıcı olarak silinsin mi?')"><%- include('partials/csrf') %><button class="btn btn-sm btn-outline-danger" title="Sil"><i class="bi bi-trash3-fill"></i></button></form></div></td></tr><% }) %></tbody></table><div id="noSearchResult" class="text-center text-muted p-5 d-none"><i class="bi bi-search fs-2 d-block mb-2"></i>Eşleşen personel bulunamadı.</div></div><% }else{ %><div class="text-center p-5"><i class="bi bi-person-plus fs-1 text-primary"></i><h4 class="mt-3">Henüz personel yok</h4><a href="/employees/new" class="btn-nova btn-primary-nova mt-2">İlk Personeli Ekle</a></div><% } %></div>
</div><%- include('partials/footer') %></main></div><script src="/js/sidebar.js"></script><script>const employeeSearch=document.getElementById('employeeSearch');if(employeeSearch)employeeSearch.addEventListener('input',function(){const value=this.value.toLocaleLowerCase('tr-TR').trim();let visible=0;document.querySelectorAll('.employee-row').forEach(row=>{const matches=(row.dataset.search||'').includes(value);row.style.display=matches?'':'none';if(matches)visible++;});document.getElementById('noSearchResult')?.classList.toggle('d-none',visible!==0);});</script></body></html>
