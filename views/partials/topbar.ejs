<header class="topbar"><div class="topbar-left"><button class="mobile-menu-button" id="menuButton" type="button"><i class="bi bi-list"></i></button><div class="topbar-title-area"><h1 class="topbar-title"><%= pageTitle %></h1><div class="topbar-subtitle">HR Nova İnsan Kaynakları Yönetim Sistemi</div></div></div><div class="topbar-right"><a href="/search" class="topbar-action" aria-label="Personel ve eğitim ara"><i class="bi bi-search"></i></a><a href="/notifications" class="topbar-action" aria-label="Bildirimler"><i class="bi bi-bell"></i><% if((notificationCount||0)>0){ %><span class="topbar-notification-dot"></span><% } %></a><button class="topbar-action" id="themeToggle" type="button" aria-label="Gece gündüz modunu değiştir"><i class="bi bi-moon" id="themeIcon"></i></button><div class="topbar-user"><div class="topbar-user-avatar"><%= currentUser.display_name.split(/\s+/).filter(Boolean).slice(0,2).map(part=>part[0]).join('').toLocaleUpperCase('tr-TR') %></div><div class="topbar-user-info"><div class="topbar-user-name"><%= currentUser.display_name %></div><div class="topbar-user-role">Sistem Yöneticisi</div></div></div></div></header>
