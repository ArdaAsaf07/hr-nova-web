<aside class="sidebar" id="sidebar">

    <!-- Logo alanı -->
    <div class="sidebar-brand">

        <a href="/" class="brand-link">

            <div class="brand-icon">
                <i class="bi bi-people-fill"></i>
            </div>

            <div class="brand-text">
                <div class="brand-title">HR Nova</div>
                <div class="brand-subtitle">İnsan Kaynakları</div>
            </div>

        </a>

    </div>

    <!-- Menü alanı -->
    <nav class="sidebar-menu">

        <div class="menu-section-title">
            Genel
        </div>

        <a
            href="/"
            class="menu-link <%= activePage === 'dashboard' ? 'active' : '' %>"
        >
            <i class="bi bi-grid-1x2-fill"></i>
            <span>Ana Sayfa</span>
        </a>

        <div class="menu-section-title">
            İnsan Kaynakları
        </div>

        <a
            href="/employees"
            class="menu-link <%= activePage === 'employees' ? 'active' : '' %>"
        >
            <i class="bi bi-people-fill"></i>
            <span>Personeller</span>
        </a>

        <a
            href="/departments"
            class="menu-link <%= activePage === 'departments' ? 'active' : '' %>"
        >
            <i class="bi bi-diagram-3-fill"></i>
            <span>Departmanlar</span>
        </a>

        <a
            href="/trainings"
            class="menu-link <%= activePage === 'trainings' ? 'active' : '' %>"
        >
            <i class="bi bi-mortarboard-fill"></i>
            <span>Eğitimler</span>
        </a>

        <a
            href="/certificates"
            class="menu-link <%= activePage === 'certificates' ? 'active' : '' %>"
        >
            <i class="bi bi-award-fill"></i>
            <span>Sertifikalar</span>
        </a>

        <div class="menu-section-title">
            Raporlama ve Aktarım
        </div>

        <a
            href="/reports"
            class="menu-link <%= activePage === 'reports' ? 'active' : '' %>"
        >
            <i class="bi bi-bar-chart-fill"></i>
            <span>Raporlar</span>
        </a>

        <a
            href="/excel"
            class="menu-link <%= activePage === 'excel' ? 'active' : '' %>"
        >
            <i class="bi bi-file-earmark-excel-fill"></i>
            <span>Excel Aktar</span>
        </a>

        <div class="menu-section-title">
            İletişim
        </div>

        <a
            href="/mail"
            class="menu-link <%= activePage === 'mail' ? 'active' : '' %>"
        >
            <i class="bi bi-envelope-fill"></i>
            <span>Mail Merkezi</span>
        </a>

        <a
            href="/notifications"
            class="menu-link <%= activePage === 'notifications' ? 'active' : '' %>"
        >
            <i class="bi bi-bell-fill"></i>
            <span>Bildirimler</span>

            <% if ((notificationCount || 0) > 0) { %><span class="menu-badge"><%= notificationCount %></span><% } %>
        </a>

        <div class="menu-section-title">
            Sistem
        </div>

        <a
            href="/users"
            class="menu-link <%= activePage === 'users' ? 'active' : '' %>"
        >
            <i class="bi bi-person-gear"></i>
            <span>Kullanıcılar</span>
        </a>

        <a
            href="/settings"
            class="menu-link <%= activePage === 'settings' ? 'active' : '' %>"
        >
            <i class="bi bi-gear-fill"></i>
            <span>Ayarlar</span>
        </a>

    </nav>

    <!-- Alt kullanıcı alanı -->
    <div class="sidebar-footer">

        <div class="sidebar-user">

            <div class="sidebar-user-avatar">
                <%= currentUser.display_name
                    .split(/\s+/)
                    .filter(Boolean)
                    .slice(0, 2)
                    .map(part => part[0])
                    .join("")
                    .toLocaleUpperCase("tr-TR") %>
            </div>

            <div class="sidebar-user-info">
                <div class="sidebar-user-name">
                    <%= currentUser.display_name %>
                </div>

                <div class="sidebar-user-role">
                    Yönetici
                </div>
            </div>

        </div>

        <form action="/logout" method="POST">
            <button type="submit" class="logout-button" title="Çıkış Yap">
                <i class="bi bi-box-arrow-right"></i>
            </button>
        </form>

    </div>

</aside>

<!-- Mobil ekranda menü açıldığında arka plan -->
<div class="sidebar-overlay" id="sidebarOverlay"></div> 
