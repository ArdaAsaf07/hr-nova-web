<%
    const trainingList =
        typeof trainings !== "undefined" && Array.isArray(trainings)
            ? trainings
            : [];

    const catalogStatusList = typeof trainingStatuses !== "undefined" && Array.isArray(trainingStatuses) ? trainingStatuses : [];
    const totalTrainingCount = trainingList.length + catalogStatusList.length;

    const upcomingCount = trainingList.filter(training => {
        const status = String(training.status || "").toLowerCase();
        return status === "yaklaşıyor" || status === "planlandı";
    }).length;

    const completedCount = trainingList.filter(training => {
        const status = String(training.status || "").toLowerCase();
        return status === "tamamlandı";
    }).length + catalogStatusList.filter(item => item.status === "Aldı").length;

    const expiredCount = trainingList.filter(training => {
        const status = String(training.status || "").toLowerCase();
        return status === "süresi doldu" || status === "geçti";
    }).length;

    function formatDate(dateValue) {
        if (!dateValue) {
            return "-";
        }

        const date = new Date(dateValue);

        if (Number.isNaN(date.getTime())) {
            return "-";
        }

        return date.toLocaleDateString("tr-TR");
    }

    function getStatusClass(statusValue) {
        const status = String(statusValue || "").toLowerCase();

        if (status === "tamamlandı") {
            return "badge-green";
        }

        if (
            status === "süresi doldu" ||
            status === "geçti" ||
            status === "iptal edildi"
        ) {
            return "badge-red";
        }

        if (status === "devam ediyor") {
            return "badge-blue";
        }

        return "badge-orange";
    }
%>

<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>HR Nova | Eğitimler</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="/css/style.css"
    >
</head>

<body>

    <div class="hr-nova-layout">

        <%- include("partials/sidebar", {
            activePage: "trainings"
        }) %>

        <main class="main-content">

            <%- include("partials/topbar", {
                pageTitle: "Eğitimler"
            }) %>

            <div class="content-wrapper">

                <!-- Sayfa başlığı -->
                <div class="page-header">

                    <div class="page-header-left">

                        <h2 class="page-title">
                            Eğitim Yönetimi
                        </h2>

                        <p class="page-description">
                            Personel eğitimlerini planlayın, sürelerini takip edin
                            ve yaklaşan yenilemeleri yönetin.
                        </p>

                    </div>

                    <div class="page-actions">

                        <button
                            type="button"
                            class="btn-nova btn-primary-nova"
                            data-bs-toggle="modal"
                            data-bs-target="#newTrainingModal"
                        >
                            <i class="bi bi-plus-circle-fill"></i>
                            Yeni Eğitim
                        </button>

                    </div>

                </div>

                <!-- İstatistik kartları -->
                <div class="row g-4 mb-4">

                    <div class="col-xl-3 col-md-6">

                        <div class="stat-card">

                            <div class="stat-card-inner">

                                <div>

                                    <div class="stat-card-label">
                                        Toplam Eğitim
                                    </div>

                                    <h3 class="stat-card-value">
                                        <%= totalTrainingCount %>
                                    </h3>

                                    <div class="stat-card-description">
                                        Sistemdeki tüm eğitimler
                                    </div>

                                </div>

                                <div class="stat-icon purple">
                                    <i class="bi bi-mortarboard-fill"></i>
                                </div>

                            </div>

                        </div>

                    </div>

                    <div class="col-xl-3 col-md-6">

                        <div class="stat-card">

                            <div class="stat-card-inner">

                                <div>

                                    <div class="stat-card-label">
                                        Yaklaşan
                                    </div>

                                    <h3 class="stat-card-value">
                                        <%= upcomingCount %>
                                    </h3>

                                    <div class="stat-card-description">
                                        Yakında başlayacak eğitimler
                                    </div>

                                </div>

                                <div class="stat-icon orange">
                                    <i class="bi bi-calendar-event-fill"></i>
                                </div>

                            </div>

                        </div>

                    </div>

                    <div class="col-xl-3 col-md-6">

                        <div class="stat-card">

                            <div class="stat-card-inner">

                                <div>

                                    <div class="stat-card-label">
                                        Tamamlanan
                                    </div>

                                    <h3 class="stat-card-value">
                                        <%= completedCount %>
                                    </h3>

                                    <div class="stat-card-description">
                                        Başarıyla tamamlananlar
                                    </div>

                                </div>

                                <div class="stat-icon green">
                                    <i class="bi bi-check-circle-fill"></i>
                                </div>

                            </div>

                        </div>

                    </div>

                    <div class="col-xl-3 col-md-6">

                        <div class="stat-card">

                            <div class="stat-card-inner">

                                <div>

                                    <div class="stat-card-label">
                                        Süresi Dolan
                                    </div>

                                    <h3 class="stat-card-value">
                                        <%= expiredCount %>
                                    </h3>

                                    <div class="stat-card-description">
                                        Yenilenmesi gereken eğitimler
                                    </div>

                                </div>

                                <div class="stat-icon red">
                                    <i class="bi bi-exclamation-triangle-fill"></i>
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <% const receivedCount = catalogStatusList.filter(item => item.status === 'Aldı').length; const notReceivedCount = catalogStatusList.filter(item => item.status === 'Almadı').length; %>
                <div class="nova-card mb-4">
                    <div class="nova-card-header"><div><h3 class="nova-card-title">Personel Eğitim Kayıtları</h3><div class="nova-card-subtitle">Excel'den aktarılan ve sonradan eklenen gerçek eğitim ilişkileri</div></div><div class="d-flex gap-2"><span class="nova-badge badge-green">Aldı: <%= receivedCount %></span><span class="nova-badge badge-red">Almadı: <%= notReceivedCount %></span></div></div>
                    <div class="p-3 border-bottom"><input id="personTrainingSearch" class="form-control-nova" type="search" placeholder="Personel veya eğitim adına göre ara..."></div>
                    <div class="nova-table-wrapper"><table class="nova-table" id="personTrainingTable"><thead><tr><th>Personel</th><th>Eğitim</th><th>Durum</th><th>Tamamlanma</th><th>İşlemler</th></tr></thead><tbody><% catalogStatusList.forEach(item => { %><tr data-search="<%= `${item.first_name} ${item.last_name} ${item.training_name}`.toLocaleLowerCase('tr-TR') %>"><td><%= item.first_name %> <%= item.last_name %></td><td><%= item.training_name %></td><td><span class="nova-badge <%= item.status === 'Aldı' ? 'badge-green' : 'badge-red' %>"><%= item.status %></span></td><td><%= item.completed_at ? formatDate(item.completed_at) : '-' %></td><td><div class="d-flex gap-2"><form action="/training-status/<%= item.id %>/update" method="POST" class="d-flex gap-1"><%- include('partials/csrf') %><select name="status" class="form-select form-select-sm"><option <%= item.status==='Aldı'?'selected':'' %>>Aldı</option><option <%= item.status==='Almadı'?'selected':'' %>>Almadı</option></select><button class="btn btn-sm btn-outline-primary">Kaydet</button></form><form action="/training-status/<%= item.id %>/delete" method="POST" onsubmit="return confirm('Bu personel eğitim kaydı silinsin mi?')"><%- include('partials/csrf') %><button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button></form></div></td></tr><% }) %></tbody></table></div>
                </div>

                <!-- Eğitim tablosu -->
                <div class="nova-card">

                    <div class="nova-card-header">

                        <div>

                            <h3 class="nova-card-title">
                                Eğitim Listesi
                            </h3>

                            <div class="nova-card-subtitle">
                                Planlanan ve tamamlanan personel eğitimleri
                            </div>

                        </div>

                        <span class="nova-badge badge-purple">
                            <i class="bi bi-journal-bookmark-fill"></i>
                            <%= totalTrainingCount %> kayıt
                        </span>

                    </div>

                    <div class="nova-card-body">

                        <div class="filter-bar">

                            <div class="search-box">

                                <i class="bi bi-search"></i>

                                <input
                                    type="text"
                                    id="trainingSearch"
                                    class="search-input"
                                    placeholder="Eğitim veya personel ara..."
                                >

                            </div>

                            <select
                                id="trainingStatusFilter"
                                class="filter-select"
                            >
                                <option value="">
                                    Tüm Durumlar
                                </option>

                                <option value="planlandı">
                                    Planlandı
                                </option>

                                <option value="devam ediyor">
                                    Devam Ediyor
                                </option>

                                <option value="tamamlandı">
                                    Tamamlandı
                                </option>

                                <option value="süresi doldu">
                                    Süresi Doldu
                                </option>
                            </select>

                        </div>

                    </div>

                    <% if (trainingList.length > 0) { %>

                        <div class="nova-table-wrapper">

                            <table
                                class="nova-table"
                                id="trainingTable"
                            >

                                <thead>

                                    <tr>
                                        <th>#</th>
                                        <th>Eğitim</th>
                                        <th>Personel</th>
                                        <th>Başlangıç</th>
                                        <th>Bitiş</th>
                                        <th>Süre</th>
                                        <th>Durum</th>
                                        <th>İşlemler</th>
                                    </tr>

                                </thead>

                                <tbody>

                                    <% trainingList.forEach((training, index) => { %>

                                        <%
                                            const trainingName =
                                                training.name ||
                                                training.training_name ||
                                                training.title ||
                                                "İsimsiz Eğitim";

                                            const employeeName =
                                                training.employee_name ||
                                                training.personnel_name ||
                                                training.full_name ||
                                                "Personel atanmadı";

                                            const status =
                                                training.status ||
                                                "Planlandı";

                                            const duration =
                                                training.duration ||
                                                training.duration_hours ||
                                                training.hours;

                                            const trainingId =
                                                training.id || "";
                                        %>

                                        <tr
                                            data-search="<%= `${trainingName} ${employeeName}`.toLowerCase() %>"
                                            data-status="<%= String(status).toLowerCase() %>"
                                        >

                                            <td>
                                                <span class="text-nova-muted">
                                                    <%= index + 1 %>
                                                </span>
                                            </td>

                                            <td>

                                                <div class="person-cell">

                                                    <div class="person-avatar">
                                                        <i class="bi bi-book-fill"></i>
                                                    </div>

                                                    <div>

                                                        <div class="person-name">
                                                            <%= trainingName %>
                                                        </div>

                                                        <div class="person-subtitle">
                                                            Personel eğitimi
                                                        </div>

                                                    </div>

                                                </div>

                                            </td>

                                            <td>
                                                <%= employeeName %>
                                            </td>

                                            <td>
                                                <%= formatDate(
                                                    training.start_date ||
                                                    training.startDate
                                                ) %>
                                            </td>

                                            <td>
                                                <%= formatDate(
                                                    training.end_date ||
                                                    training.endDate
                                                ) %>
                                            </td>

                                            <td>
                                                <%= duration
                                                    ? `${duration} saat`
                                                    : "-"
                                                %>
                                            </td>

                                            <td>

                                                <span
                                                    class="nova-badge <%= getStatusClass(status) %>"
                                                >
                                                    <%= status %>
                                                </span>

                                            </td>

                                            <td>

                                                <div class="table-actions">

                                                    <a
                                                        href="/trainings/<%= trainingId %>/edit"
                                                        class="btn-icon-nova btn-icon-edit"
                                                        title="Düzenle"
                                                    >
                                                        <i class="bi bi-pencil-fill"></i>
                                                    </a>

                                                    <form
                                                        action="/trainings/<%= trainingId %>/delete"
                                                        method="POST"
                                                        onsubmit="return confirm('Bu eğitimi silmek istediğine emin misin?')"
                                                    >

                                                        <button
                                                            type="submit"
                                                            class="btn-icon-nova btn-icon-delete"
                                                            title="Sil"
                                                        >
                                                            <i class="bi bi-trash-fill"></i>
                                                        </button>

                                                    </form>

                                                </div>

                                            </td>

                                        </tr>

                                    <% }) %>

                                </tbody>

                            </table>

                        </div>

                        <div class="table-footer">

                            <div>
                                Toplam
                                <strong><%= totalTrainingCount %></strong>
                                eğitim gösteriliyor.
                            </div>

                        </div>

                    <% } else { %>

                        <div class="empty-state">

                            <div class="empty-state-icon">
                                <i class="bi bi-mortarboard"></i>
                            </div>

                            <h4 class="empty-state-title">
                                Henüz eğitim bulunmuyor
                            </h4>

                            <p class="empty-state-text">
                                İlk eğitim planını oluşturarak personel eğitimlerini
                                takip etmeye başlayabilirsiniz.
                            </p>

                            <button
                                type="button"
                                class="btn-nova btn-primary-nova"
                                data-bs-toggle="modal"
                                data-bs-target="#newTrainingModal"
                            >
                                <i class="bi bi-plus-circle-fill"></i>
                                İlk Eğitimi Oluştur
                            </button>

                        </div>

                    <% } %>

                </div>

            </div>

            <%- include("partials/footer") %>

        </main>

    </div>

    <!-- Yeni eğitim modalı -->
    <div
        class="modal fade"
        id="newTrainingModal"
        tabindex="-1"
        aria-hidden="true"
    >

        <div class="modal-dialog modal-lg modal-dialog-centered">

            <div class="modal-content border-0 rounded-4">

                <div class="modal-header border-bottom">

                    <div>

                        <h5 class="modal-title fw-bold">
                            Yeni Eğitim Oluştur
                        </h5>

                        <div class="text-nova-muted small mt-1">
                            Personel için yeni eğitim kaydı oluşturun.
                        </div>

                    </div>

                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                    ></button>

                </div>

                <form action="/trainings" method="POST">

                    <div class="modal-body p-4">

                        <div class="row g-3">

                            <div class="col-md-6">

                                <label class="form-label-nova">
                                    Eğitim Adı
                                    <span class="form-required">*</span>
                                </label>

                                <input
                                    type="text"
                                    name="name"
                                    class="form-control-nova"
                                    placeholder="Örneğin: İş Sağlığı ve Güvenliği"
                                    required
                                >

                            </div>

                            <div class="col-md-6">

                                <label class="form-label-nova">
                                    Personel
                                </label>

                                <select
                                    name="employee_id"
                                    class="form-select-nova"
                                >
                                    <option value="">
                                        Personel seçin
                                    </option>

                                    <% if (
                                        typeof employees !== "undefined" &&
                                        Array.isArray(employees)
                                    ) { %>

                                        <% employees.forEach(employee => { %>

                                            <option value="<%= employee.id %>">
                                                <%= employee.first_name || employee.ad || "" %>
                                                <%= employee.last_name || employee.soyad || "" %>
                                            </option>

                                        <% }) %>

                                    <% } %>

                                </select>

                            </div>

                            <div class="col-md-6">

                                <label class="form-label-nova">
                                    Başlangıç Tarihi
                                    <span class="form-required">*</span>
                                </label>

                                <input
                                    type="date"
                                    name="start_date"
                                    class="form-control-nova"
                                    required
                                >

                            </div>

                            <div class="col-md-6">

                                <label class="form-label-nova">
                                    Bitiş Tarihi
                                </label>

                                <input
                                    type="date"
                                    name="end_date"
                                    class="form-control-nova"
                                >

                            </div>

                            <div class="col-md-6">

                                <label class="form-label-nova">
                                    Eğitim Süresi
                                </label>

                                <input
                                    type="number"
                                    name="duration"
                                    class="form-control-nova"
                                    min="1"
                                    placeholder="Saat"
                                >

                            </div>

                            <div class="col-md-6">

                                <label class="form-label-nova">
                                    Durum
                                </label>

                                <select
                                    name="status"
                                    class="form-select-nova"
                                >
                                    <option value="Planlandı">
                                        Planlandı
                                    </option>

                                    <option value="Devam Ediyor">
                                        Devam Ediyor
                                    </option>

                                    <option value="Tamamlandı">
                                        Tamamlandı
                                    </option>

                                    <option value="Süresi Doldu">
                                        Süresi Doldu
                                    </option>
                                </select>

                            </div>

                            <div class="col-12">

                                <label class="form-label-nova"> 
                                    Açıklama
                                </label>

                                <textarea
                                    name="description"
                                    class="form-control-nova"
                                    placeholder="Eğitim hakkında açıklama..."
                                ></textarea>

                            </div>

                        </div>

                    </div>

                    <div class="modal-footer border-top">

                        <button
                            type="button"
                            class="btn-nova btn-secondary-nova"
                            data-bs-dismiss="modal"
                        >
                            Vazgeç
                        </button>

                        <button
                            type="submit"
                            class="btn-nova btn-primary-nova"
                        >
                            <i class="bi bi-check-circle-fill"></i>
                            Eğitimi Kaydet
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    ></script>

    <script src="/js/sidebar.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const personSearch = document.getElementById("personTrainingSearch");
            const personRows = document.querySelectorAll("#personTrainingTable tbody tr");
            if (personSearch) personSearch.addEventListener("input", function () {
                const value = this.value.toLocaleLowerCase("tr-TR").trim();
                personRows.forEach(row => row.style.display = (row.dataset.search || "").includes(value) ? "" : "none");
            });
            const searchInput =
                document.getElementById("trainingSearch");

            const statusFilter =
                document.getElementById("trainingStatusFilter");

            const tableRows =
                document.querySelectorAll("#trainingTable tbody tr");

            function filterTrainings() {
                const searchValue =
                    searchInput
                        ? searchInput.value.toLowerCase().trim()
                        : "";

                const statusValue =
                    statusFilter
                        ? statusFilter.value.toLowerCase().trim()
                        : "";

                tableRows.forEach(function (row) {
                    const rowSearch =
                        row.dataset.search || "";

                    const rowStatus =
                        row.dataset.status || "";

                    const matchesSearch =
                        rowSearch.includes(searchValue);

                    const matchesStatus =
                        !statusValue ||
                        rowStatus === statusValue;

                    row.style.display =
                        matchesSearch && matchesStatus
                            ? ""
                            : "none";
                });
            }

            if (searchInput) {
                searchInput.addEventListener(
                    "input",
                    filterTrainings
                );
            }

            if (statusFilter) {
                statusFilter.addEventListener(
                    "change",
                    filterTrainings
                );
            }
        });
    </script>

</body>

</html>
