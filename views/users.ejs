<!DOCTYPE html><html lang="tr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>HR Nova | Kullanıcı Takibi</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet"><link rel="stylesheet" href="/css/style.css"></head><body><div class="hr-nova-layout"><%- include("partials/sidebar", { activePage: "users" }) %><main class="main-content"><%- include("partials/topbar", { pageTitle: "Kullanıcı Takibi" }) %><div class="content-wrapper"><div class="page-header"><div class="page-header-left"><h2 class="page-title">Kullanıcı Takibi</h2><p class="page-description">Yönetici hesaplarını, açık oturumları ve son işlemleri görün.</p></div></div><div class="nova-card mb-4"><div class="nova-card-header"><h3 class="nova-card-title">Yönetici Hesapları</h3></div><div class="nova-table-wrapper"><table class="nova-table"><thead><tr><th>Kullanıcı</th><th>Rol</th><th>Durum</th><th>Açık oturum</th><th>Son giriş</th></tr></thead><tbody><% users.forEach(user => { %><tr><td><strong><%= user.display_name %></strong><br><small>@<%= user.username %></small></td><td><%= user.role %></td><td><span class="nova-badge <%= user.is_active ? 'badge-green' : 'badge-red' %>"><%= user.is_active ? 'Aktif' : 'Kapalı' %></span></td><td><%= user.active_sessions %></td><td><%= user.last_login_at ? new Date(user.last_login_at).toLocaleString('tr-TR') : 'Henüz giriş yok' %></td></tr><% }) %></tbody></table></div></div><div class="nova-card"><div class="nova-card-header"><div><h3 class="nova-card-title">Son İşlemler</h3><div class="nova-card-subtitle">Son 100 değişiklik kaydı</div></div></div><div class="nova-table-wrapper"><table class="nova-table"><thead><tr><th>Kullanıcı</th><th>İşlem</th><th>Adres</th><th>Sonuç</th><th>Zaman</th></tr></thead><tbody><% activity.forEach(item => { %><tr><td><%= item.display_name || 'Sistem' %></td><td><%= item.method %></td><td><%= item.path %></td><td><%= item.status_code %></td><td><%= new Date(item.created_at).toLocaleString('tr-TR') %></td></tr><% }) %><% if (!activity.length) { %><tr><td colspan="5">Henüz kayıtlı işlem yok.</td></tr><% } %></tbody></table></div></div></div><%- include("partials/footer") %></main></div><script src="/js/sidebar.js"></script></body></html>
